APP_ENV=production
# PostgreSQL Supabase : connexion serveur via le pooler de transactions, TLS vérifié.
DATABASE_URL=
# Le certificat public Supabase est intégré au serveur.
# 32 octets aléatoires encodés en hexadécimal ; exclusivement côté serveur.
SESSION_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_REDIRECT_URI=
# URL privée historique, jamais publiée dans le frontend.
OWNER_LOGIN_PATH=

# Facultatif : secret serveur Netlify (12 caractères minimum, 72 octets maximum).
# Remplace le mot de passe historique du propriétaire ; changement effectif après déploiement.
OWNER_PASSWORD=
