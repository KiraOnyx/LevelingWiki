APP_ENV=production
# PostgreSQL Supabase : connexion serveur via le pooler de transactions, TLS vérifié.
DATABASE_URL=
DATABASE_CA_CERT=
# 32 octets aléatoires encodés en hexadécimal ; exclusivement côté serveur.
SESSION_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_REDIRECT_URI=
# URL privée historique, jamais publiée dans le frontend.
OWNER_LOGIN_PATH=

# Stockage privé des captures et illustrations de guides.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=levelingwiki-private
UPLOAD_MAX_BYTES=5242880
GUIDE_IMAGE_MAX_BYTES=5242880
GUIDE_IMAGE_MAX_PIXELS=20000000
GUIDE_IMAGE_MAX_COUNT=30
