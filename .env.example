APP_ENV=production
# PostgreSQL Supabase : connexion serveur via le pooler de transactions, TLS vérifié.
DATABASE_URL=
# Le certificat public Supabase est intégré au serveur.
# 32 octets aléatoires encodés en hexadécimal ; exclusivement côté serveur.
SESSION_SECRET=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_REDIRECT_URI=
# URL privée historique, jamais publiée dans le frontend.
OWNER_LOGIN_PATH=
