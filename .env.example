APP_ENV=development
DB_HOST=database
DB_PORT=3306
DB_DATABASE=levelingwiki
DB_USERNAME=levelingwiki
# Remplacer les deux valeurs avant le premier démarrage.
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Authentification : délais en secondes ; activer Secure en HTTPS.
SESSION_IDLE_SECONDS=86400
SESSION_ABSOLUTE_SECONDS=86400
SESSION_SECURE_COOKIE=0
UPLOAD_MAX_BYTES=5242880

# Discord OAuth2 (aucun bot nécessaire). Remplacer xxxx par le vrai serveur.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_GUILD_ID=
DISCORD_REDIRECT_URI=http://localhost:8080/auth/discord/callback
DISCORD_ROLE_TTL=86400
# Générer via bin/owner-access.php ; aucune valeur réelle à versionner.
OWNER_LOGIN_PATH=
